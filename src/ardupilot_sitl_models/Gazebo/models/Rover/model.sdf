<sdf version='1.7'>

<!-- ________________Rover _________________-->
    <model name='rover' canonical_link='chassis_link'>

<!-- ________________Chassis________________-->
        <link name="chassis_link">
            <pose>0 0 0 0 0 0</pose>
            <visual name="chassis_visual">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>meshes/chassis_simple.stl</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>1 1 0 1</ambient>
                    <diffuse>1 0.8 0 1</diffuse>
                    <specular>1 1 1 1</specular>
                    <emissive>0.5 0.5 0 1</emissive>
                </material>
            </visual>
            <collision name="chassis_collision">
            <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>meshes/chassis_simple.stl</uri>
                    </mesh>
                </geometry>
            </collision>
            <inertial>
                <pose>0 0 0.116 0 0 0</pose>
                <mass>76.476</mass>
                <inertia>
                    <ixx>3.032</ixx>
                    <ixy>-0.001</ixy>
                    <ixz>-0.077</ixz>
                    <iyy>9.132</iyy>
                    <iyz>-0.003</iyz>
                    <izz>11.061</izz>
                </inertia>
            </inertial>
        </link>


    <!--____________ Wheels _____________-->

        <!-- front right wheel-->
        <joint name='front_right_wheel_joint' type='revolute'>
            <pose relative_to='chassis_link'>0.362 -0.441 -0.043 0 0 0</pose>
            <parent>chassis_link</parent>
            <child>front_right_wheel_link</child>
            <axis>
                <xyz expressed_in='front_right_wheel_link'>0 1 0</xyz> 
                <limit>
                    <lower>-1.79769e+308</lower>    
                    <upper>1.79769e+308</upper>     
                </limit>
                <dynamics>
                    <damping>0.02</damping>
                </dynamics>
            </axis>
        </joint>

        <link name="front_right_wheel_link">
            <pose relative_to='front_right_wheel_joint'>0 0 0 0 0 0</pose>
            <visual name="front_right_wheel_visual">
                <pose>0 0 0 1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.18</radius>
                        <length>0.18</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse> 
                    <specular>0.05 0.05 0.05 1</specular> 
                    <emissive>0 0 0 1</emissive> 
                </material>
            </visual>
            <collision name="front_right_wheel_collision">
                <pose>0 0 0 1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.18</radius>
                        <length>0.18</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>10</mu>
                            <mu2>5</mu2>
                            <fdir1>1 0 0</fdir1>
                            <slip1>0.002</slip1>
                            <slip2>0.002</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <inertial>
                <pose>0 0 0 0 0 1.57</pose>
                <mass>8</mass>
                <inertia>
                    <ixx>0.12</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.076</iyy>
                    <iyz>0</iyz>
                    <izz>0.076</izz>
                </inertia>
            </inertial>
        </link>

        <!-- front left wheel -->
        <joint name='front_left_wheel_joint' type='revolute'>
            <pose relative_to='chassis_link'>0.362 0.441 -0.043 0 0 0</pose>
            <parent>chassis_link</parent>
            <child>front_left_wheel_link</child>
            <axis>
                <xyz expressed_in='front_left_wheel_link'>0 1 0</xyz> 
                <limit>
                    <lower>-1.79769e+308</lower>   
                    <upper>1.79769e+308</upper>    
                </limit>
                <dynamics>
                    <damping>0.02</damping>
                </dynamics>
            </axis>
        </joint>

        <link name="front_left_wheel_link">
            <pose relative_to='front_left_wheel_joint'>0 0 0 0 0 0</pose>
            <visual name="front_left_wheel_visual">
                <pose>0 0 0 1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.18</radius>
                        <length>0.18</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse> 
                    <specular>0.05 0.05 0.05 1</specular> 
                    <emissive>0 0 0 1</emissive> 
                </material>
            </visual>
            <collision name="front_left_wheel_collision">
                <pose>0 0 0 1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.18</radius>
                        <length>0.18</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>10</mu>
                            <mu2>5</mu2>
                            <fdir1>1 0 0</fdir1>
                            <slip1>0.002</slip1>
                            <slip2>0.002</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <inertial>
                <pose>0 0 0 0 0 1.57</pose>
                <mass>8</mass>
                <inertia>
                    <ixx>0.12</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.076</iyy>
                    <iyz>0</iyz>
                    <izz>0.076</izz>
                </inertia>
            </inertial>
        </link>

        <!-- back right wheel -->
        <joint name='back_right_wheel_joint' type='revolute'>
            <pose relative_to='chassis_link'>-0.362 -0.441 -0.043 0 0 0</pose>
            <parent>chassis_link</parent>
            <child>back_right_wheel_link</child>
            <axis>
                <xyz expressed_in='chassis_link'>0 1 0</xyz> 
                <limit>
                    <lower>-1.79769e+308</lower>    
                    <upper>1.79769e+308</upper>     
                </limit>
                <dynamics>
                    <damping>0.02</damping>
                </dynamics>
            </axis>
        </joint>

        <link name="back_right_wheel_link">
            <pose relative_to='back_right_wheel_joint'>0 0 0 0 0 0</pose>
            <visual name="back_right_wheel_visual">
                <pose>0 0 0 1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.18</radius>
                        <length>0.18</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse> 
                    <specular>0.05 0.05 0.05 1</specular> 
                    <emissive>0 0 0 1</emissive> 
                </material>
            </visual>
            <collision name="back_right_wheel_collision">
                <pose>0 0 0 1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.18</radius>
                        <length>0.18</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>10</mu>
                            <mu2>5</mu2>
                            <fdir1>1 0 0</fdir1>
                            <slip1>0.002</slip1>
                            <slip2>0.002</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <inertial>
                <pose>0 0 0 0 0 1.57</pose>
                <mass>8</mass>
                <inertia>
                    <ixx>0.12</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.076</iyy>
                    <iyz>0</iyz>
                    <izz>0.076</izz>
                </inertia>
            </inertial>
        </link>

        <!-- back left wheel -->
        <joint name='back_left_wheel_joint' type='revolute'>
            <pose relative_to='chassis_link'>-0.362 0.441 -0.043 0 0 0</pose>
            <parent>chassis_link</parent>
            <child>back_left_wheel_link</child>
            <axis>
                <xyz expressed_in='chassis_link'>0 1 0</xyz> 
                <limit>
                    <lower>-1.79769e+308</lower>    
                    <upper>1.79769e+308</upper>    
                </limit>
                <dynamics>
                    <damping>0.02</damping>
                </dynamics>
            </axis>
        </joint>

        <link name="back_left_wheel_link">
            <pose relative_to='back_left_wheel_joint'>0 0 0 0 0 0</pose>
            <visual name="back_left_wheel_visual">
                <pose>0 0 0 1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.18</radius>
                        <length>0.18</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse> 
                    <specular>0.05 0.05 0.05 1</specular> 
                    <emissive>0 0 0 1</emissive> 
                </material>
            </visual>
            <collision name="back_left_wheel_collision">
                <pose>0 0 0 1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.18</radius>
                        <length>0.18</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>10</mu>
                            <mu2>5</mu2>
                            <fdir1>1 0 0</fdir1>
                            <slip1>0.002</slip1>
                            <slip2>0.002</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <inertial>
                <pose>0 0 0 0 0 1.57</pose>
                <mass>8</mass>
                <inertia>
                    <ixx>0.12</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.076</iyy>
                    <iyz>0</iyz>
                    <izz>0.076</izz>
                </inertia>
            </inertial>
        </link>

        <!-- RP LiDar C2-->
        <joint name='RPLiDar_joint' type='fixed'>
            <pose relative_to='chassis_link'>0.300 0 0.251 0 0 0</pose>
            <parent>chassis_link</parent>
            <child>RPLiDar_link</child>
        </joint>

        <link name="RPLiDar_link">
            <sensor name='gpu_lidar' type='gpu_lidar'>"
                <pose relative_to='chassis_link'>0.300 0 0.251 0 0 0</pose>
                <topic>lidar</topic>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>640</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>0.01</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.08</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <always_on>1</always_on>
                <visualize>true</visualize>
            </sensor>
            <visual name="RPLiDar_visual">
                <pose relative_to='chassis_link'>0.300 0 0.251 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.04</radius>
                        <length>0.04</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse> 
                    <specular>0.05 0.05 0.05 1</specular> 
                    <emissive>0 0 0 1</emissive> 
                </material>
            </visual>
            <collision name="RPLiDar_collision">
                <pose relative_to='chassis_link'>0.300 0 0.251 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.04</radius>
                        <length>0.04</length>
                    </cylinder>
                </geometry>
            </collision>
            <inertial>
                <pose>0.300 0 0.251 0 0 0</pose>
                <mass>0.2</mass>
                <inertia>
                    <ixx>0.00010825</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.00016459</iyy>
                    <iyz>0</iyz>
                    <izz>0.00010825</izz>
                </inertia>
            </inertial>
        </link>

            <!-- IMU -->
            <joint name='rover/imu_joint' type='revolute'>
                <pose relative_to='chassis_link'>0 0 0.693 0 0 0</pose>
                <child>imu_link</child>
                <parent>chassis_link</parent>
                <axis>
                    <xyz>0 0 1</xyz>
                    <limit>
                    <lower>0</lower>
                    <upper>0</upper>
                    <effort>0</effort>
                    <velocity>0</velocity>
                    </limit>
                    <dynamics>
                    <damping>1.0</damping>
                    </dynamics>
                </axis>
        </joint>

        <link name='imu_link'>
            <pose relative_to='rover/imu_joint'>0 0 0 0 0 0</pose>
            <visual name="imu_visual">
                <pose>0 0 0 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.04</radius>
                        <length>0.04</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse> 
                    <specular>0.05 0.05 0.05 1</specular> 
                    <emissive>0 0 0 1</emissive> 
                </material>
            </visual>
            <inertial>
                <pose>0 0 0 0 0 0</pose>
                <mass>0.15</mass>
                <inertia>
                <ixx>0.00002</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.00002</iyy>
                <iyz>0</iyz>
                <izz>0.00002</izz>
                </inertia>
            </inertial>
            <sensor name="imu_sensor" type="imu">
                <pose degrees="true">0 0 0 180 0 0</pose>
                <always_on>1</always_on>
                <update_rate>1000.0</update_rate>
            </sensor>
        </link>

        <!-- plugins -->
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        </plugin>

        <plugin
            filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>chassis_link</robot_base_frame>
            <dimensions>3</dimensions>
        </plugin>

        <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
            <joint_name>front_right_wheel_joint</joint_name>
        </plugin>

        <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
            <joint_name>front_left_wheel_joint</joint_name>
        </plugin>

        <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
            <joint_name>back_right_wheel_joint</joint_name>
        </plugin>

        <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
            <joint_name>back_left_wheel_joint</joint_name>
        </plugin>

        <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
            <!-- Port settings -->
            <fdm_addr>127.0.0.1</fdm_addr>
            <fdm_port_in>9002</fdm_port_in>
            <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
            <lock_step>1</lock_step>

            <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
            <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

            <!-- Sensors -->
            <imuName>imu_sensor</imuName>
            <lidarName>gpu_lidar</lidarName>
            <!--
                Rover
                    - max_lin_vel   5 km/h = 1.39 m/s
                    - wheel_radius  0.180 m
                    - max_ang_vel   23.15 rad/s
                    - multiplier    46.30 rad/s

                pwm:            =>  [1000, 2000] 
                input:          =>  [0, 1]
                offset: -0.5    =>  [-0.5, 0.5]
                scale:   2.0    =>  [-1.0, 1.0]
                scale:   23.15  =>  [-5.0, 5.0]
                -->

            <!-- 
                SERVO1_FUNCTION   73 (Throttle Left)
                SERVO1_MAX        2000
                SERVO1_MIN        1000
                SERVO1_REVERSED   0
                SERVO1_TRIM       1500
            -->
            <control channel="0">
                <jointName>front_left_wheel_joint</jointName>
                <useForce>1</useForce>
                <multiplier>92.6</multiplier>
                <offset>-0.5</offset>
                <servo_min>1000</servo_min>
                <servo_max>2000</servo_max>
                <type>VELOCITY</type>
                <p_gain>0.8</p_gain>
                <i_gain>0.12</i_gain>
                <d_gain>0.0002</d_gain>
                <i_max>1</i_max>
                <i_min>-1</i_min>
                <cmd_max>-1</cmd_max>
                <cmd_min>0</cmd_min>
            </control>

            <control channel="0">
                <jointName>back_left_wheel_joint</jointName>
                <useForce>1</useForce>
                <multiplier>92.6</multiplier>
                <offset>-0.5</offset>
                <servo_min>1000</servo_min>
                <servo_max>2000</servo_max>
                <type>VELOCITY</type>
                <p_gain>0.8</p_gain>
                <i_gain>0.12</i_gain>
                <d_gain>0.0002</d_gain>
                <i_max>1</i_max>
                <i_min>-1</i_min>
                <cmd_max>-1</cmd_max>
                <cmd_min>0</cmd_min>
            </control>

            <!-- 
                SERVO3_FUNCTION   74 (Throttle Right)
                SERVO3_MAX        2000
                SERVO3_MIN        1000
                SERVO3_REVERSED   0
                SERVO3_TRIM       1500
            -->
            <control channel="2">
                <jointName>front_right_wheel_joint</jointName>
                <useForce>1</useForce>
                <multiplier>92.6</multiplier>
                <offset>-0.5</offset>
                <servo_min>1000</servo_min>
                <servo_max>2000</servo_max>
                <type>VELOCITY</type>
                <p_gain>0.8</p_gain>
                <i_gain>0.12</i_gain>
                <d_gain>0.0002</d_gain>
                <i_max>1</i_max>
                <i_min>-1</i_min>
                <cmd_max>-1</cmd_max>
                <cmd_min>0</cmd_min>
            </control>

            <control channel="2">
                <jointName>back_right_wheel_joint</jointName>
                <useForce>1</useForce>
                <multiplier>92.6</multiplier>
                <offset>-0.5</offset>
                <servo_min>1000</servo_min>
                <servo_max>2000</servo_max>
                <type>VELOCITY</type>
                <p_gain>0.8</p_gain>
                <i_gain>0.12</i_gain>
                <d_gain>0.0002</d_gain>
                <i_max>1</i_max>
                <i_min>-1</i_min>
                <cmd_max>-1</cmd_max>
                <cmd_min>0</cmd_min>
                
            </control>
        </plugin>

    </model>

</sdf>

